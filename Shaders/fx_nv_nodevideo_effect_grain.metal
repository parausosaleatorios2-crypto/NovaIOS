// O RT 128 × 128 com REPEAT e filtro linear (em luz linear: o buffer é sRGB e o texelFetch já decodifica).
static float4 lerRuido(float2 uv) {
    float2 q = uv * 128.0 - 0.5;
    float2 f = fract(q);
    int2 b = int2(floor(q));
    float4 a00 = ruido.read(uint2((b & 127)), uint(0));
    float4 a10 = ruido.read(uint2(((b + int2(1, 0)) & 127)), uint(0));
    float4 a01 = ruido.read(uint2(((b + int2(0, 1)) & 127)), uint(0));
    float4 a11 = ruido.read(uint2(((b + int2(1, 1)) & 127)), uint(0));
    return mix(mix(a00, a10, f.x), mix(a01, a11, f.x), f.y);
}

// O programa 2 do shader NodeVideo/Effect/grain do Node, conta por conta (tools/nodepassesc/montar.py).
static float4 aplicar(float2 in.vs_TEXCOORD0)
{
    float4 SV_Target0 = float4(0.0);
    float4 u_xlat0;
    float4 u_xlat1;
    float3 u_xlat2;
    bool2 u_xlatb2;
    float4 u_xlat3;
    float4 u_xlat4;
    float4 u_xlat5;
    float u_xlat19;

    u_xlat0 = nvFonte( in.vs_TEXCOORD0.xy);
    u_xlat1.xy = in.vs_TEXCOORD0.xy + float2(-0.5, -0.5);
    u_xlat1.xy = u_xlat1.xy * float2(u._scale.x, u._scale.y);
    u_xlat1.xyz = lerRuido( u_xlat1.xy).xyz;
    u_xlat2.xyz = u_xlat0.xyz;
    u_xlat2.xyz = clamp(u_xlat2.xyz, 0.0, 1.0);
    u_xlat19 = dot(u_xlat2.xyz, float3(0.300000012, 0.589999974, 0.109999999));
    u_xlat19 = sqrt(u_xlat19);
    u_xlat2.x = (-u._amount) + 1.0;
    u_xlat19 = u_xlat2.x * (-u_xlat19) + 1.0;
    u_xlat1.xyz = u_xlat0.xyz * u_xlat1.xyz;
    u_xlat1.xyz = u_xlat1.xyz * float3(float3(u._intensity, u._intensity, u._intensity));
    u_xlat1.xyz = float3(u_xlat19) * u_xlat1.xyz;
    u_xlat1.xyz = u_xlat1.xyz * float3(30.0, 30.0, 30.0) + u_xlat0.xyz;
    if(0 != 0) {
        u_xlatb2.xy = equal(int4(0, 0, 0, 0), int4(1, 1, 0, 0)).xy;
        u_xlat1.w = u_xlat0.w;
        u_xlat3 = (u_xlatb2.x) ? float4(1.0, 0.0, 1.0, 1.0) : u_xlat1;
        u_xlat4 = nvFonte( in.vs_TEXCOORD0.xy);
        u_xlat5 = (-u_xlat4) + float4(1.0, 1.0, 1.0, 1.0);
        u_xlat5 = u_xlat0 * u_xlat5;
        u_xlat3 = u_xlat3 * u_xlat4 + u_xlat5;
        u_xlat0.x = u_xlat4.x * u_xlat3.w;
        SV_Target0.w = (u_xlatb2.y) ? u_xlat0.x : u_xlat3.w;
        SV_Target0.xyz = u_xlat3.xyz;
    } else {
        SV_Target0.xyz = u_xlat1.xyz;
        SV_Target0.w = u_xlat0.w;
    }
    return SV_Target0;
    return SV_Target0;
}

fragment float4 fx_nv_nodevideo_effect_grain(
    NovaVertexOut       in   [[stage_in]],
    constant EngineUniforms& eng [[buffer(0)]],
    constant nv_nodevideo_effect_grainParams&  u    [[buffer(1)]],
    sampler             __nv_smp [[sampler(0)]],
    texture2d<float> inputImg [[texture(0)]],
    texture2d<float> ruido [[texture(1)]])
{
    float4 __nv_fragCoord = in.position;
    float2 __nv_pointCoord = in.uv;
    float4 __nv_out = float4(0.0);

    if (eng.acPass == 0) {
        // O Blit do Node num RT de 128: in.vs_TEXCOORD0 = o meio do texel.
        float2 uv = __nv_fragCoord.xy / 128.0;
        __nv_out = u._colored ? ruidoColorido(uv) : ruidoCinza(uv);
        return __nv_out;
    }
    __nv_out = nvVolta(aplicar(nvUvDePe()));
    return __nv_out;
}
