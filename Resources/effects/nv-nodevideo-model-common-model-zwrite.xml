<?xml version="1.0" encoding="utf-8"?>
<!--
  NodeVideo/Model_common_model_zwrite
  Gerado automaticamente do data.unity3d do NodeVideo (HLSLcc → GLSL ES 300).
  Entradas renomeadas: _SourceTex → inputImg, vs_TEXCOORD0 → acScreenNorm,
  SV_Target0 → fragColor. Faixas dos sliders são palpites por nome — ajuste conforme o visual.
-->
<effect
    id="nv.effect.nodevideo-model-common-model-zwrite"
    name="Model Common Model Zwrite (NV)"
    name-en="Model Common Model Zwrite (NV)"
    desc="NodeVideo effect 'NodeVideo/Model_common_model_zwrite', decompiled do bundle .unity3d."
    desc-en="NodeVideo effect 'NodeVideo/Model_common_model_zwrite', decompiled do bundle .unity3d."
    category="nodevideo"
    tags="nodevideo,nv,unity,asset-store">

    <params>
        <texture id="inputImg" src="content" />
    </params>

    <shader><![CDATA[
vec4 u_xlat0;
bool u_xlatb0;
float u_xlat1;
void main()
{
    u_xlat0 = texture(inputImg, acScreenNorm.xy);
    u_xlat1 = u_xlat0.w + -0.100000001;
    fragColor = u_xlat0;
    u_xlatb0 = u_xlat1<0.0;
    if(u_xlatb0){discard;}
    return;
}
    ]]></shader>
</effect>
