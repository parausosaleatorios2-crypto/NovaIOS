<?xml version="1.0" encoding="utf-8"?>
<!--
  S_Glare — efeito no estilo do Sapphire, feito para o NovaEditor iOS (shader
  original de GPU em Shaders/fx_sapphire_glare.metal; o <shader> abaixo é só a cópia
  da entrada para o Android).
-->
<effect
    id="nova.effect.ios.sapphire-glare"
    name="S_Glare"
    name-en="S_Glare"
    desc="Brilho com estrela de quatro pontas e halo nas luzes mais fortes."
    desc-en="Brilho com estrela de quatro pontas e halo nas luzes mais fortes."
    category="stylize"
    tags="glare,estrela,brilho,halo,luz,sapphire,boris fx">

    <params>
        <texture id="inputImg" src="content" />
        <slider id="threshold" label="Threshold" default="0.8" min="0.0" max="1.0" step="0.01" snap="0.8" />
        <slider id="brightness" label="Brightness" default="1.2" min="0.0" max="10.0" step="0.01" snap="1.2" />
        <slider id="size" label="Size" default="150.0" min="0.0" max="800.0" step="1.0" snap="150.0" />
        <slider id="rotate" label="Rotate" type="angle" default="0.0" min="-360.0" max="360.0" step="1.0" snap="0.0" />
        <color id="color" label="Color" default="#FFFFFF" />
    </params>

    <shader><![CDATA[
void main() {
    fragColor = texture(inputImg, acScreenNorm);
}
    ]]></shader>
</effect>
