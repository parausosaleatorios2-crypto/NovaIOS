<?xml version="1.0" encoding="utf-8"?>
<!--
  Magic Bullet Looks (Red Giant) — Lift-Gamma-Gain (`lggn`, linear): as três rodas de cor (sombras, meios-tons e
  luzes) num "espaço de gama", com a força e a compensação de exposição da própria ferramenta. Lida no
  `MBLooksUI_5_0.dll` (21/10/2026): o render `0x1803f5b70` e o kernel `ColorKernel_LiftGammaGain`
  (tools/looks/benchmark/lggn.py); o host é o `ContasDoLooks.liftGammaGain`. Os 12 valores na ordem do bloco, com
  os nomes do Looks.

  `stage="mblooks"`: este `<shader>` é só a cópia da entrada. Na cadeia, a cabeça "Magic Bullet Looks" e as
  ferramentas logo depois dela são UMA passada do motor (`render/PasseDoLooks`), como uma instância do efeito
  no AE: a camada em 8 bits, linear, cada ferramenta no espaço dela, Strength, 8 bits. Uma ferramenta sem
  cabeça antes roda sozinha, com força 100.
-->
<effect
    id="nova.effect.mblooks.liftgammagain"
    name="Looks: Lift-Gamma-Gain"
    name-en="Looks: Lift-Gamma-Gain"
    desc="A ferramenta Lift-Gamma-Gain do Magic Bullet Looks: as três rodas de cor (sombras, meios-tons e luzes) por canal, com força e compensação de exposição."
    desc-en="Magic Bullet Looks' Lift-Gamma-Gain tool: the three color wheels (shadows, midtones and highlights) per channel, with strength and exposure compensation."
    category="looks"
    stage="mblooks"
    looks="lggn"
    tags="magic bullet,looks,red giant,lift,gamma,gain,color wheels,rodas de cor,sombras,luzes">

    <params>
        <texture id="inputImg" src="content" />
        <slider id="gammaSpace" label="Gamma Space" default="2.2" min="0.1" max="5.0" step="0.01" />
        <slider id="strength" label="Strength" default="100.0" min="0.0" max="100.0" step="0.1" />
        <slider id="exposure" label="Exposure Compensation" default="0.0" min="-5.0" max="5.0" step="0.01" />
        <slider id="liftRed" group="Lift" label="Red Lift" default="1.0" min="0.0" max="2.0" step="0.001" />
        <slider id="liftGreen" group="Lift" label="Green Lift" default="1.0" min="0.0" max="2.0" step="0.001" />
        <slider id="liftBlue" group="Lift" label="Blue Lift" default="1.0" min="0.0" max="2.0" step="0.001" />
        <slider id="gammaRed" group="Gamma" label="Red Gamma" default="1.0" min="0.0" max="2.0" step="0.001" />
        <slider id="gammaGreen" group="Gamma" label="Green Gamma" default="1.0" min="0.0" max="2.0" step="0.001" />
        <slider id="gammaBlue" group="Gamma" label="Blue Gamma" default="1.0" min="0.0" max="2.0" step="0.001" />
        <slider id="gainRed" group="Gain" label="Red Gain" default="1.0" min="0.0" max="2.0" step="0.001" />
        <slider id="gainGreen" group="Gain" label="Green Gain" default="1.0" min="0.0" max="2.0" step="0.001" />
        <slider id="gainBlue" group="Gain" label="Blue Gain" default="1.0" min="0.0" max="2.0" step="0.001" />
    </params>

    <!-- Na vitrine, o padrão não muda nada: sombras frias e luzes quentes (o bloco do vfxcc3, mais forte). -->
    <preview>
        <set param="liftRed" value="0.85" />
        <set param="liftBlue" value="1.05" />
        <set param="gainRed" value="1.08" />
        <set param="gainBlue" value="0.9" />
    </preview>

    <!-- A cópia da entrada: quem desenha é o `PasseDoLooks` (o motor do Looks inteiro, ver o comentário do topo). -->
    <shader><![CDATA[
void main() {
    fragColor = texture(inputImg, acScreenNorm);
}
    ]]></shader>
</effect>
