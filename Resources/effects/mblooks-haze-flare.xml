<?xml version="1.0" encoding="utf-8"?>
<!--
  Magic Bullet Looks (Red Giant) — Haze/Flare (`haze`, linear). O render do host (`0x1803f40d0`, lido em
  `tools/looks/benchmark/haze.py`): a luz que vaza pelas laterais do quadro e se espalha em névoa.
    1. `FXKernel_HazeSideMatte`: a imagem × duas faixas nas laterais (Spillage = a largura delas);
    2. o gaussiano do motor (Softness) e um segundo SÓ NA HORIZONTAL (Reach, até ~1/3 da largura): o rastro;
    3. `FXKernel_RectMaskAlpha`: o Matte Box, um retângulo arredondado no meio do quadro (Matte Box Size);
    4. `FXKernel_HazeFlare`: a névoa somada à imagem com 1,1·2^Exposure·Tint, escurecida fora do Matte Box pelo
       Matte Box Shade; Reflection soma a névoa espelhada na horizontal com 2^Reflection Exposure.
  (`assets/mblooks/hazelado.frag` + `gauss.comp` + `hazecaixa.frag` + `hazeflare.frag`.) Conferido contra o After
  Effects (rodada `haze`, LEIAME.md): até 1 nível em 0,07% dos valores.

  Os padrões NÃO estão no motor (o slot 9 devolve 0 para todos): são o bloco que mais se repete na pasta de presets.
  Os limites também não: saíram dos presets, com folga.

  O Looks é um motor de GPU (`MBLooksUI_5_0.dll`): o host transforma os valores de cada ferramenta nas
  constantes de um kernel. Os kernels foram lidos (DXIL) e reescritos em `assets/mblooks`; o host, em
  `model/ContasDoLooks.kt`. Conferido contra o After Effects (`tools/looks/benchmark`, LEIAME.md).

  `stage="mblooks"`: este `<shader>` é só a cópia da entrada. Na cadeia, a cabeça "Magic Bullet Looks" e as
  ferramentas logo depois dela são UMA passada do motor (`render/PasseDoLooks`), como uma instância do efeito
  no AE: a camada em 8 bits, linear, cada ferramenta no espaço dela, Strength, 8 bits. Uma ferramenta sem
  cabeça antes roda sozinha, com força 100.
-->
<effect
    id="nova.effect.mblooks.hazeflare"
    name="Looks: Haze/Flare"
    name-en="Looks: Haze/Flare"
    desc="A ferramenta Haze/Flare do Magic Bullet Looks: luz que vaza pelas laterais e se espalha em névoa colorida pelo quadro, com reflexo e matte box."
    desc-en="Magic Bullet Looks' Haze/Flare tool: light leaking in from the sides and spreading as a tinted haze across the frame, with reflection and matte box."
    category="looks"
    stage="mblooks"
    looks="haze"
    tags="magic bullet,looks,red giant,haze,flare,névoa,nevoa,vazamento de luz,light leak,glow,brilho">

    <params>
        <texture id="inputImg" src="content" />
        <slider id="spillage" label="Spillage" default="30.0" min="0.0" max="100.0" step="0.1" />
        <slider id="softness" label="Softness" default="10.0" min="0.0" max="100.0" step="0.1" />
        <slider id="reach" label="Reach" default="50.0" min="0.0" max="100.0" step="0.1" />
        <slider id="exposure" label="Exposure" default="-1.0" min="-6.0" max="6.0" step="0.01" />
        <slider id="reflectionExposure" label="Reflection Exposure" default="0.0" min="-6.0" max="6.0" step="0.01" />
        <switch id="reflection" label="Reflection" default="true" />
        <slider id="matteBoxSize" label="Matte Box Size" default="50.0" min="0.0" max="100.0" step="0.1" />
        <slider id="matteBoxShade" label="Matte Box Shade" default="75.0" min="0.0" max="100.0" step="0.1" />
        <slider id="tintRed" group="Tint Color" label="Tint Red" default="1.0" min="0.0" max="8.0" step="0.001" />
        <slider id="tintGreen" group="Tint Color" label="Tint Green" default="0.7" min="0.0" max="8.0" step="0.001" />
        <slider id="tintBlue" group="Tint Color" label="Tint Blue" default="0.5" min="0.0" max="8.0" step="0.001" />
    </params>

    <!-- A cópia da entrada: quem desenha é o `PasseDoLooks` (o motor do Looks inteiro, ver o comentário do topo). -->
    <shader><![CDATA[
void main() {
    fragColor = texture(inputImg, acScreenNorm);
}
    ]]></shader>
</effect>
