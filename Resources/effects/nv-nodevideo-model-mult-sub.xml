<?xml version="1.0" encoding="utf-8"?>
<!--
  NodeVideo/Model_mult_sub
  Gerado automaticamente do data.unity3d do NodeVideo (HLSLcc → GLSL ES 300).
  Entradas renomeadas: _SourceTex → inputImg, vs_TEXCOORD0 → acScreenNorm,
  SV_Target0 → fragColor. Faixas dos sliders são palpites por nome — ajuste conforme o visual.
-->
<effect
    id="nv.effect.nodevideo-model-mult-sub"
    name="Model Mult Sub (NV)"
    name-en="Model Mult Sub (NV)"
    desc="NodeVideo effect 'NodeVideo/Model_mult_sub', decompiled do bundle .unity3d."
    desc-en="NodeVideo effect 'NodeVideo/Model_mult_sub', decompiled do bundle .unity3d."
    category="nodevideo"
    tags="nodevideo,nv,unity,asset-store">

    <params>
        <texture id="inputImg" src="content" />
        <color id="_tex_tiling0" label="Tex Tiling0" default="#FFFFFFFF" />
        <color id="_tex_offset0" label="Tex Offset0" default="#FFFFFFFF" />
    </params>

    <shader><![CDATA[
vec2 u_xlat0;
void main()
{
    u_xlat0.xy = acScreenNorm.xy * _tex_tiling0.xy + _tex_offset0.xy;
    u_xlat0.xy = fract(abs(u_xlat0.xy));
    fragColor = texture(inputImg, u_xlat0.xy);
    return;
}
    ]]></shader>
</effect>
