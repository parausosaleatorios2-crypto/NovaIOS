<?xml version="1.0" encoding="utf-8"?>
<!--
  NodeVideo/Model_fracture_no_light
  Gerado automaticamente do data.unity3d do NodeVideo (HLSLcc → GLSL ES 300).
  Entradas renomeadas: _SourceTex → inputImg, vs_TEXCOORD0 → acScreenNorm,
  SV_Target0 → fragColor. Faixas dos sliders são palpites por nome — ajuste conforme o visual.
-->
<effect
    id="nv.effect.nodevideo-model-fracture-no-light"
    name="Model Fracture No Light (NV)"
    name-en="Model Fracture No Light (NV)"
    desc="NodeVideo effect 'NodeVideo/Model_fracture_no_light', decompiled do bundle .unity3d."
    desc-en="NodeVideo effect 'NodeVideo/Model_fracture_no_light', decompiled do bundle .unity3d."
    category="nodevideo"
    tags="nodevideo,nv,unity,asset-store">

    <params>
        <texture id="inputImg" src="content" />
        <slider id="_opacity" label="Opacity" default="0.5" min="0.0" max="1.0" step="0.01" />
    </params>

    <shader><![CDATA[
vec4 u_xlat0;
void main()
{
    u_xlat0 = texture(inputImg, acScreenNorm.xy);
    fragColor.w = u_xlat0.w * _opacity;
    fragColor.xyz = u_xlat0.xyz;
    return;
}
    ]]></shader>
</effect>
