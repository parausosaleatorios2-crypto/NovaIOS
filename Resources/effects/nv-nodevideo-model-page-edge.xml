<?xml version="1.0" encoding="utf-8"?>
<!--
  NodeVideo/Model_page_edge
  Gerado automaticamente do data.unity3d do NodeVideo (HLSLcc → GLSL ES 300).
  Entradas renomeadas: _SourceTex → inputImg, vs_TEXCOORD0 → acScreenNorm,
  SV_Target0 → fragColor. Faixas dos sliders são palpites por nome — ajuste conforme o visual.
-->
<effect
    id="nv.effect.nodevideo-model-page-edge"
    name="Model Page Edge (NV)"
    name-en="Model Page Edge (NV)"
    desc="NodeVideo effect 'NodeVideo/Model_page_edge', decompiled do bundle .unity3d."
    desc-en="NodeVideo effect 'NodeVideo/Model_page_edge', decompiled do bundle .unity3d."
    category="nodevideo"
    tags="nodevideo,nv,unity,asset-store">

    <params>
        <texture id="inputImg" src="content" />
        <color id="_edge_color" label="Edge Color" default="#FFFFFFFF" />
    </params>

    <shader><![CDATA[
void main()
{
    fragColor = _edge_color;
    return;
}
    ]]></shader>
</effect>
