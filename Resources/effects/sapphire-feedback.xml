<?xml version="1.0" encoding="utf-8"?>
<!--
  S_Feedback — efeito no estilo do Sapphire, feito para o NovaEditor iOS (shader
  original de GPU em Shaders/fx_sapphire_feedback.metal; o <shader> abaixo é só a cópia
  da entrada para o Android).
-->
<effect
    id="nova.effect.ios.sapphire-feedback"
    name="S_Feedback"
    name-en="S_Feedback"
    desc="Cópias da imagem que encolhem e giram para o centro, como um túnel de vídeo."
    desc-en="Cópias da imagem que encolhem e giram para o centro, como um túnel de vídeo."
    category="stylize"
    tags="feedback,tunel,copias,zoom,eco,sapphire,boris fx">

    <params>
        <texture id="inputImg" src="content" />
        <point id="center" label="Center" defaultX="0.5" defaultY="0.5" />
        <slider id="zoom" label="Zoom Per Step" default="0.85" min="0.3" max="1.5" step="0.01" snap="0.85" />
        <slider id="rotate" label="Rotate Per Step" type="angle" default="8.0" min="-180.0" max="180.0" step="1.0" snap="8.0" />
        <slider id="steps" label="Steps" type="integer" default="8" min="1" max="24" step="1" />
        <slider id="decay" label="Decay" default="0.8" min="0.0" max="1.0" step="0.01" snap="0.8" />
        <slider id="hueShift" label="Hue Shift" default="0.0" min="0.0" max="1.0" step="0.01" snap="0.0" />
    </params>

    <shader><![CDATA[
void main() {
    fragColor = texture(inputImg, acScreenNorm);
}
    ]]></shader>
</effect>
