<?xml version="1.0" encoding="utf-8"?>
<!--
  S_UnMult — efeito no estilo do Sapphire, feito para o NovaEditor iOS (shader
  original de GPU em Shaders/fx_sapphire_unmult.metal; o <shader> abaixo é só a cópia
  da entrada para o Android).
-->
<effect
    id="nova.effect.ios.sapphire-unmult"
    name="S_UnMult"
    name-en="S_UnMult"
    desc="Tira o preto: o brilho vira transparência (bom para luzes, fogo e flares em fundo preto)."
    desc-en="Tira o preto: o brilho vira transparência (bom para luzes, fogo e flares em fundo preto)."
    category="color"
    tags="unmult,tirar preto,transparencia,alpha,luma,sapphire,boris fx">

    <params>
        <texture id="inputImg" src="content" />
        <slider id="gain" label="Gain" default="1.0" min="0.1" max="4.0" step="0.01" snap="1.0" />
        <slider id="threshold" label="Black Threshold" default="0.0" min="0.0" max="0.5" step="0.01" snap="0.0" />
    </params>

    <shader><![CDATA[
void main() {
    fragColor = texture(inputImg, acScreenNorm);
}
    ]]></shader>
</effect>
