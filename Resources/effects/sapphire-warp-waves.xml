<?xml version="1.0" encoding="utf-8"?>
<!--
  S_WarpWaves — efeito no estilo do Sapphire, feito para o NovaEditor iOS (shader
  original de GPU em Shaders/fx_sapphire_warp_waves.metal; o <shader> abaixo é só a cópia
  da entrada para o Android).
-->
<effect
    id="nova.effect.ios.sapphire-warp-waves"
    name="S_WarpWaves"
    name-en="S_WarpWaves"
    desc="Ondas que deformam a imagem, com velocidade, direção e forma da onda."
    desc-en="Ondas que deformam a imagem, com velocidade, direção e forma da onda."
    category="distort"
    tags="warp waves,ondas,wave,distorcer,sapphire,boris fx">

    <params>
        <texture id="inputImg" src="content" />
        <slider id="amplitude" label="Amplitude" default="20.0" min="0.0" max="300.0" step="1.0" snap="20.0" />
        <slider id="wavelength" label="Wavelength" default="200.0" min="4.0" max="2000.0" step="1.0" snap="200.0" />
        <slider id="speed" label="Speed" default="1.0" min="-20.0" max="20.0" step="0.01" snap="1.0" />
        <slider id="angle" label="Direction" type="angle" default="0.0" min="-360.0" max="360.0" step="1.0" snap="0.0" />
        <selector id="shape" label="Wave Shape" default="0" options="Seno|Triângulo|Quadrada" />
        <slider id="phase" label="Phase" default="0.0" min="-360.0" max="360.0" step="1.0" snap="0.0" />
    </params>

    <shader><![CDATA[
void main() {
    fragColor = texture(inputImg, acScreenNorm);
}
    ]]></shader>
</effect>
