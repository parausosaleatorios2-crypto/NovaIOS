<?xml version="1.0" encoding="utf-8"?>
<!--
  S_WarpMagnify — efeito no estilo do Sapphire, feito para o NovaEditor iOS (shader
  original de GPU em Shaders/fx_sapphire_warp_magnify.metal; o <shader> abaixo é só a cópia
  da entrada para o Android).
-->
<effect
    id="nova.effect.ios.sapphire-warp-magnify"
    name="S_WarpMagnify"
    name-en="S_WarpMagnify"
    desc="Lupa: aumenta uma região redonda da imagem, com borda suave."
    desc-en="Lupa: aumenta uma região redonda da imagem, com borda suave."
    category="distort"
    tags="warp magnify,lupa,zoom,lente,aumentar,sapphire,boris fx">

    <params>
        <texture id="inputImg" src="content" />
        <point id="center" label="Center" defaultX="0.5" defaultY="0.5" />
        <slider id="radius" label="Radius" default="250.0" min="0.0" max="2000.0" step="1.0" snap="250.0" />
        <slider id="magnify" label="Magnify" default="2.0" min="0.1" max="10.0" step="0.01" snap="2.0" />
        <slider id="softness" label="Edge Softness" default="0.3" min="0.0" max="1.0" step="0.01" snap="0.3" />
    </params>

    <shader><![CDATA[
void main() {
    fragColor = texture(inputImg, acScreenNorm);
}
    ]]></shader>
</effect>
