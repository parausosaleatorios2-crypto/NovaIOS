<?xml version="1.0" encoding="utf-8"?>
<!--
  PISCAR (ANTIGO) — o `com.alightcreative.effects.blink` do Alight Motion (0.563.0).

  O AM marca este como "deprecated" (o atual é o `blink2`, `am-blink.xml`), mas os projetos feitos antes ainda o
  trazem: existe para a importação e fica fora do catálogo. A mesma ideia do atual (`model/Piscar.kt`), com uma
  diferença lida do script dele: a Frequência não acumula — entra como `(tempo × duração × frequência do instante)
  % 1 > 0,5`, em double, e com quadro-chave a camada pula. Não é do tipo "hz", como lá.
-->
<effect
    id="nova.effect.am-blink-legacy"
    name="Piscar (antigo)"
    name-en="Blink (legacy)"
    desc="O Piscar antigo do Alight Motion, dos projetos feitos antes da versão atual dele."
    desc-en="Alight Motion's old Blink, from projects made before its current version."
    category="opacity"
    stage="transform"
    catalog="false"
    tags="piscar,blink,alight motion">

    <params>
        <texture id="inputImg" src="content" />

        <spinner id="freq" label="Frequência" default="2.0" min="0.1" max="16.0" step="0.1" />
    </params>

    <shader><![CDATA[

void main() {
    fragColor = texture(inputImg, acScreenNorm);
}

    ]]></shader>
</effect>
