<!--
  NodeVideo/Effect/Stylize/Glow — o Glow do Node Video (classe NodeVideo.AE.AEGlow), portado com os passes do C#
  (0.916, tools/nodeluzes; antes só o pré-filtro, que saía preto).

  O C# (AEGlow.Render/UpdateRenderBuffers/PrepareScattering, il2cpp) é o bloom do Kino: RTs "_down_sample0..N" a
  partir da METADE da composição (cada um a metade do anterior) e "_up_sample0..N-1"; N e o _BloomSpread saem do
  Espalhamento e do tamanho (a conta está no shader, `nvLogh`). Blit(camada → ds0, passe 0: o pré-filtro de 13
  leituras com o limiar e a cor); ds(i) = passe 1 (descida) de ds(i-1); up(j-1) = passe 2 (subida 3x3 de up(j) ou
  ds(N), mais ds(j-1) como _HigherMipBloomTex); e Blit(camada → saída, passe 3: a subida de up0 × Intensidade +
  a camada). O `_preserve_alpha` da definição (esconde-se atrás de um `_mode` que não existe, partida falso) troca o
  shader pelo GlowOld; com ele desligado, é sempre este.

  AQUI: o passe 0 guarda a camada como o RT do Node (pré-multiplicada em luz linear, sRGB de 8 bits); os RTs do meio
  são sRGB de 8 bits como os do Node; os 4 programas copiados (gerar.py); o último volta à cor reta do Nova, e o
  brilho que passa do alfa (fora do recorte) vira alfa. Na tela (`stage="screen"`), como no Node.

  O que fica diferente: N preso a 7 (o motor desce até 1/256; o Node não tem teto — só passa de 7 com Espalhamento
  acima de ~8 em 1080p); N e o espalhar saem do buffer em que o efeito roda, não da composição (na exportação é o
  mesmo; na prévia reduzida o brilho cobre a mesma fração da tela); o Node compõe em luz linear e o Nova em gama; a
  máscara interna do Node fica desligada.
-->
<effect
    id="nv.effect.nodevideo-effect-stylize-glow"
    name="Effect Stylize Glow (NV)"
    name-en="Effect Stylize Glow (NV)"
    desc="Brilho (bloom) nas partes claras, largo e suave (o Glow do Node Video)."
    desc-en="Brilho (bloom) nas partes claras, largo e suave (o Glow do Node Video)."
    category="nodevideo"
    tags="nodevideo,nv,unity,asset-store,brilho,bloom,glow"
    stage="screen"
>

    <params>
        <!-- `highp`: os 8 bits da camada chegam exatos à conversão para luz linear. -->
        <texture id="inputImg" src="content" precision="highp" />
        <!-- O RT da camada no Node: pré-multiplicada em luz linear, sRGB de 8 bits (o passe 0). -->
        <texture id="pre" src="buffer" format="srgb" precision="highp" />
        <!-- Os RTs do C# (_down_sample0..N e _up_sample0..N-1): a metade da composição, e a metade da metade... -->
        <texture id="ds0" src="buffer" scale="0.5" format="srgb" />
        <texture id="ds1" src="buffer" scale="0.25" format="srgb" />
        <texture id="ds2" src="buffer" scale="0.125" format="srgb" />
        <texture id="ds3" src="buffer" scale="0.0625" format="srgb" />
        <texture id="ds4" src="buffer" scale="0.03125" format="srgb" />
        <texture id="ds5" src="buffer" scale="0.015625" format="srgb" />
        <texture id="ds6" src="buffer" scale="0.0078125" format="srgb" />
        <texture id="ds7" src="buffer" scale="0.00390625" format="srgb" />
        <texture id="up0" src="buffer" scale="0.5" format="srgb" />
        <texture id="up1" src="buffer" scale="0.25" format="srgb" />
        <texture id="up2" src="buffer" scale="0.125" format="srgb" />
        <texture id="up3" src="buffer" scale="0.0625" format="srgb" />
        <texture id="up4" src="buffer" scale="0.03125" format="srgb" />
        <texture id="up5" src="buffer" scale="0.015625" format="srgb" />
        <texture id="up6" src="buffer" scale="0.0078125" format="srgb" />
        <slider id="_BloomScattering" label="Scattering" default="7" min="1" max="10" step="0.01" />
        <slider id="_BloomThreshold_x" label="Threshold" default="0.3" min="0" max="1" step="0.01" />
        <slider id="_BloomThreshold_y" label="Threshold Max" default="1" min="0" max="1" step="0.01" />
        <slider id="_BloomIntensity" label="Intensity" default="1" min="0" max="10" step="0.01" />
        <color id="_glow_color" label="Glow Color" default="#FFFFFFFF" />
    </params>

    <passes>
        <pass target="pre" />
        <pass target="ds0" />
        <pass target="ds1" />
        <pass target="ds2" />
        <pass target="ds3" />
        <pass target="ds4" />
        <pass target="ds5" />
        <pass target="ds6" />
        <pass target="ds7" />
        <pass target="up6" />
        <pass target="up5" />
        <pass target="up4" />
        <pass target="up3" />
        <pass target="up2" />
        <pass target="up1" />
        <pass target="up0" />
        <pass />
    </passes>

