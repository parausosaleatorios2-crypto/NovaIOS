<?xml version="1.0" encoding="utf-8"?>
<!--
  S_Vignette — efeito no estilo do Sapphire, feito para o NovaEditor iOS (shader
  original de GPU em Shaders/fx_sapphire_vignette.metal; o <shader> abaixo é só a cópia
  da entrada para o Android).
-->
<effect
    id="nova.effect.ios.sapphire-vignette"
    name="S_Vignette"
    name-en="S_Vignette"
    desc="Vinheta com cor, tamanho, suavidade e forma ajustáveis."
    desc-en="Vinheta com cor, tamanho, suavidade e forma ajustáveis."
    category="stylize"
    tags="vignette,vinheta,bordas,escurecer,sapphire,boris fx">

    <params>
        <texture id="inputImg" src="content" />
        <point id="center" label="Center" defaultX="0.5" defaultY="0.5" />
        <slider id="amount" label="Amount" default="0.6" min="0.0" max="1.0" step="0.01" snap="0.6" />
        <slider id="size" label="Size" default="0.7" min="0.0" max="2.0" step="0.01" snap="0.7" />
        <slider id="softness" label="Softness" default="0.5" min="0.01" max="1.0" step="0.01" snap="0.5" />
        <slider id="roundness" label="Roundness" default="1.0" min="0.0" max="1.0" step="0.01" snap="1.0" />
        <color id="color" label="Color" default="#000000" />
    </params>

    <shader><![CDATA[
void main() {
    fragColor = texture(inputImg, acScreenNorm);
}
    ]]></shader>
</effect>
