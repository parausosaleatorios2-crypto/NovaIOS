<?xml version="1.0" encoding="utf-8"?>
<!--
  NodeVideo/RenderCommand_shape_mask
  Gerado automaticamente do data.unity3d do NodeVideo (HLSLcc → GLSL ES 300).
  Entradas renomeadas: _SourceTex → inputImg, vs_TEXCOORD0 → acScreenNorm,
  SV_Target0 → fragColor. Faixas dos sliders são palpites por nome — ajuste conforme o visual.
-->
<effect
    id="nv.effect.nodevideo-rendercommand-shape-mask"
    name="Rendercommand Shape Mask (NV)"
    name-en="Rendercommand Shape Mask (NV)"
    desc="NodeVideo effect 'NodeVideo/RenderCommand_shape_mask', decompiled do bundle .unity3d."
    desc-en="NodeVideo effect 'NodeVideo/RenderCommand_shape_mask', decompiled do bundle .unity3d."
    category="nodevideo"
    tags="nodevideo,nv,unity,asset-store">

    <params>
        <texture id="inputImg" src="content" />
        <texture id="Mask" src="content" empty="transparent" />
        <slider id="_show_inner_mask" type="integer" label="Show Inner Mask" default="0" min="0" max="1" step="1" />
    </params>

    <shader><![CDATA[
vec4 u_xlat0;
vec4 u_xlat1;
bool u_xlatb1;
void main()
{
    u_xlat0 = texture(Mask, acScreenNorm.xy);
    u_xlatb1 = 0<int(_show_inner_mask);
    if(u_xlatb1){
        fragColor = u_xlat0 * vec4(1.0, 0.0, 1.0, 1.0);
        return;
    }
    u_xlat1 = texture(inputImg, acScreenNorm.xy);
    fragColor = u_xlat0 * u_xlat1;
    return;
}
    ]]></shader>
</effect>
