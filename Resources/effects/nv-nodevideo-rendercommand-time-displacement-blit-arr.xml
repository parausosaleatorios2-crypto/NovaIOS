<effect
    id="nv.effect.nodevideo-rendercommand-time-displacement-blit-arr"
    name="Rendercommand  Time Displacement Blit Arr (NV)"
    name-en="Rendercommand  Time Displacement Blit Arr (NV)"
    desc="NodeVideo effect 'NodeVideo/RenderCommand__time_displacement_blit_arr', decompiled do bundle .unity3d."
