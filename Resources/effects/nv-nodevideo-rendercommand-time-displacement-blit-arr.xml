    category="nodevideo"
    tags="nodevideo,nv,unity,asset-store">

    <params>
        <texture id="inputImg" src="content" />
        <slider id="_src_idx" type="integer" label="Src Idx" default="0" min="0" max="10" step="1" />
    </params>

    <shader><![CDATA[
vec3 u_xlat0;
void main()
{
    u_xlat0.z = float(_src_idx);
    u_xlat0.xy = acScreenNorm.xy;
    fragColor = texture(inputImg, u_xlat0.xyz);
    return;
}
    ]]></shader>
</effect>
