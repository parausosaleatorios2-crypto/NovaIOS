<?xml version="1.0" encoding="utf-8"?>
<!--
  S_Distort — efeito no estilo do Sapphire, feito para o NovaEditor iOS (shader
  original de GPU em Shaders/fx_sapphire_distort.metal; o <shader> abaixo é só a cópia
  da entrada para o Android).
-->
<effect
    id="nova.effect.ios.sapphire-distort"
    name="S_Distort"
    name-en="S_Distort"
    desc="Distorção por ruído animado, como calor ou água sobre a imagem."
    desc-en="Distorção por ruído animado, como calor ou água sobre a imagem."
    category="distort"
    tags="distort,distorcao,ruido,calor,heat,agua,sapphire,boris fx">

    <params>
        <texture id="inputImg" src="content" />
        <slider id="amount" label="Amount" default="15.0" min="0.0" max="300.0" step="1.0" snap="15.0" />
        <slider id="frequency" label="Frequency" default="6.0" min="0.1" max="100.0" step="0.01" snap="6.0" />
        <slider id="speed" label="Speed" default="1.0" min="0.0" max="20.0" step="0.01" snap="1.0" />
        <slider id="octaves" label="Octaves" type="integer" default="3" min="1" max="6" step="1" />
        <slider id="seed" label="Seed" default="0.0" min="0.0" max="1000.0" step="1.0" snap="0.0" />
    </params>

    <shader><![CDATA[
void main() {
    fragColor = texture(inputImg, acScreenNorm);
}
    ]]></shader>
</effect>
