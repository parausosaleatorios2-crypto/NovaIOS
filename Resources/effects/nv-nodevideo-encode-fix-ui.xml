<?xml version="1.0" encoding="utf-8"?>
<!--
  NodeVideo/encode_fix_ui
  Gerado automaticamente do data.unity3d do NodeVideo (HLSLcc → GLSL ES 300).
  Entradas renomeadas: _SourceTex → inputImg, vs_TEXCOORD0 → acScreenNorm,
  SV_Target0 → fragColor. Faixas dos sliders são palpites por nome — ajuste conforme o visual.
-->
<effect
    id="nv.effect.nodevideo-encode-fix-ui"
    name="Encode Fix Ui (NV)"
    name-en="Encode Fix Ui (NV)"
    desc="NodeVideo effect 'NodeVideo/encode_fix_ui', decompiled do bundle .unity3d."
    desc-en="NodeVideo effect 'NodeVideo/encode_fix_ui', decompiled do bundle .unity3d."
    category="nodevideo"
    tags="nodevideo,nv,unity,asset-store">

    <params>
        <texture id="inputImg" src="content" />
    </params>

    <shader><![CDATA[
void main()
{
    fragColor = texture(inputImg, acScreenNorm.xy);
    return;
}
    ]]></shader>
</effect>
