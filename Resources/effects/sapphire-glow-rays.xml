<?xml version="1.0" encoding="utf-8"?>
<!--
  S_GlowRays — efeito no estilo do Sapphire, feito para o NovaEditor iOS (shader
  original de GPU em Shaders/fx_sapphire_glow_rays.metal; o <shader> abaixo é só a cópia
  da entrada para o Android).
-->
<effect
    id="nova.effect.ios.sapphire-glow-rays"
    name="S_GlowRays"
    name-en="S_GlowRays"
    desc="Brilho com raios de luz saindo de um ponto, a partir das partes claras da imagem."
    desc-en="Brilho com raios de luz saindo de um ponto, a partir das partes claras da imagem."
    category="stylize"
    tags="glow rays,raios,god rays,luz,brilho,sapphire,boris fx">

    <params>
        <texture id="inputImg" src="content" />
        <point id="center" label="Center" defaultX="0.5" defaultY="0.5" />
        <slider id="rayLength" label="Ray Length" default="0.5" min="0.0" max="2.0" step="0.01" snap="0.5" />
        <slider id="threshold" label="Threshold" default="0.5" min="0.0" max="1.0" step="0.01" snap="0.5" />
        <slider id="brightness" label="Brightness" default="1.5" min="0.0" max="10.0" step="0.01" snap="1.5" />
        <slider id="glow" label="Glow" default="0.5" min="0.0" max="4.0" step="0.01" snap="0.5" />
        <color id="color" label="Color" default="#FFF2D9" />
    </params>

    <shader><![CDATA[
void main() {
    fragColor = texture(inputImg, acScreenNorm);
}
    ]]></shader>
</effect>
