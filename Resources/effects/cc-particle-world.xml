<!--
  ============================================================================
   CC PARTICLE WORLD — o PW.aex do CycoreFX HD 1.8.5 (o que vem com o After Effects 2023)
  ============================================================================

  Pedido do snow (28/10/2026): "faça o cc particle world 100% igual o do after effects e em 3d tmb".

  DE ONDE VEIO (tools/ccparticleworld): o plugin descompilado (Ghidra + o assembly, capstone) e portado na ordem das
  contas do caminho de 8 bpc — a simulação inteira por fórmula fechada (as 11 animações, gravidade, resistência,
  Extra/Extra Angle, herança do produtor, os quatro Floor Action com o quique sorteado, visibilidade e reflexo no
  chão), a cor e a opacidade pela idade (os cinco Color Map), o Volume Shade, a câmera do efeito e a CÂMERA 3D DA
  COMP, o Depth Cue e os rasterizadores dos 26 Particle Type, com os quatro Transfer Mode. As lentes e os tipos
  texturizados amostram a imagem com as funções do próprio AE (PF_SubpixelSample / PF_AreaSample, lidas do PF.dll e
  conferidas contra ele: 0 diferenças em 36 mil chamadas).

  O ORÁCULO é o PW.aex chamado fora do AE (tools/ccparticleworld/leitura/host.py, que bate com o AE: 0 de diferença
  nos renders de conferência). Contra ele, 334 de 335 casos saem com 0 bytes diferentes (o que falta: um pixel, 1
  nível de alfa, na Lens Convex com uma câmera da comp bem longe).

  Roda na CPU (PasseDoParticleWorld; a conta em model/ccparticleworld/), como o plugin: a ordem das somas em double e
  float importa e um shader não a garante. Sem estado entre quadros: cada quadro refaz as partículas vivas pelo
  tempo de nascimento delas — dá o mesmo resultado tocando de qualquer ponto.

  UNIDADES (as do plugin): posição, raio e tamanhos em larguras da camada, origem no centro; y para BAIXO
  (gravidade positiva puxa para baixo; Floor Position é o chão abaixo do centro).

  O QUE NÃO ENTROU (ver docs/PENDENCIAS-DOS-EFEITOS-AE.md, seção CC Particle World): o Opacity Map desenhado no painel
  do AE (vale a curva padrão); Texture Time "Birth"/"From Start" usam a textura do quadro atual; o desfoque de
  movimento do AE (shutter); a câmera ortográfica; o Grid & Guides (no AE é só desenho de interface).
-->
<effect
    id="nova.effect.ccparticleworld"
    name="CC Particle World"
    name-en="CC Particle World"
    desc="Sistema de partículas em 3D do After Effects (CycoreFX): produtor, física, chão, 26 tipos de partícula e a câmera 3D da composição, com o mesmo resultado do AE."
    desc-en="After Effects' 3D particle system (CycoreFX): producer, physics, floor, 26 particle types and the composition's 3D camera, matching After Effects."
    category="generate"
    stage="particleworld"
    tags="cc particle world,particle world,partículas,particles,particulas,sistema de partículas,chuva,rain,neve,snow,faíscas,sparks,fogo,fire,explosão,explosion,bolhas,bubbles,estrelas,stars,3d,cycore,after effects">

    <params>
        <texture id="inputImg" src="content" />

        <slider id="birthRate" label="Birth Rate" default="2.0" min="0.0" max="30000.0" step="0.1" />
        <slider id="longevity" label="Longevity (sec)" default="1.0" min="0.0" max="3000.0" step="0.01" />

        <slider id="posX" group="Producer" label="Position X" default="0.0" min="-10000.0" max="10000.0" step="0.01" />
        <slider id="posY" group="Producer" label="Position Y" default="0.0" min="-10000.0" max="10000.0" step="0.01" />
        <slider id="posZ" group="Producer" label="Position Z" default="0.0" min="-10000.0" max="10000.0" step="0.01" />
        <slider id="radX" group="Producer" label="Radius X" default="0.025" min="0.0" max="10000.0" step="0.001" />
        <slider id="radY" group="Producer" label="Radius Y" default="0.025" min="0.0" max="10000.0" step="0.001" />
        <slider id="radZ" group="Producer" label="Radius Z" default="0.025" min="0.0" max="10000.0" step="0.001" />

        <selector id="animation" group="Physics" label="Animation" default="1"
            options="Explosive|Direction Axis|Cone Axis|Viscouse|Twirl|Twirly|Vortex|Fire|Jet Sideways|Fractal Omni|Fractal Uni"
            values="1|2|3|5|6|7|8|9|11|13|14" />
        <slider id="velocity" group="Physics" label="Velocity" default="1.0" min="-1000.0" max="1000.0" step="0.01" />
        <slider id="inheritVelocity" group="Physics" label="Inherit Velocity %" default="0.0" min="-10000.0" max="10000.0" step="0.1" />
        <slider id="gravity" group="Physics" label="Gravity" default="0.5" min="-1000.0" max="1000.0" step="0.001" />
        <slider id="resistance" group="Physics" label="Resistance" default="0.0" min="0.0" max="50.0" step="0.1" />
        <slider id="extra" group="Physics" label="Extra" default="0.5" min="-1000.0" max="1000.0" step="0.01" />
        <slider id="extraAngle" group="Physics" label="Extra Angle" default="360.0" min="-36000.0" max="36000.0" step="1.0" type="angle" />
        <slider id="floorPosition" group="Floor" label="Floor Position" default="0.2" min="-1000.0" max="1000.0" step="0.01" />
        <selector id="particleVisibility" group="Floor" label="Particle Visibility" default="1"
            options="All|Above Floor|After Floor" values="1|2|3" />
        <selector id="renderAnimation" group="Floor" label="Render Animation" default="1"
            options="Normal|Reflected on Floor|Projected on Floor" values="1|2|3" />
        <selector id="floorAction" group="Floor" label="Floor Action" default="1"
            options="None|Ice|Glue|Bounce" values="1|2|3|4" />
        <slider id="bounciness" group="Floor" label="Bounciness" default="65.0" min="0.0" max="100.0" step="0.1" />
        <slider id="randomBounciness" group="Floor" label="Random Bounciness" default="25.0" min="0.0" max="100.0" step="0.1" />
        <slider id="bounceSpread" group="Floor" label="Bounce Spread" default="10.0" min="0.0" max="100.0" step="0.1" />
        <slider id="axisX" group="Direction Axis" label="Axis X" default="0.0" min="-1.0" max="1.0" step="0.001" />
        <slider id="axisY" group="Direction Axis" label="Axis Y" default="-1.0" min="-1.0" max="1.0" step="0.001" />
        <slider id="axisZ" group="Direction Axis" label="Axis Z" default="0.0" min="-1.0" max="1.0" step="0.001" />
        <slider id="gravityX" group="Gravity Vector" label="Gravity X" default="0.0" min="-1.0" max="1.0" step="0.001" />
        <slider id="gravityY" group="Gravity Vector" label="Gravity Y" default="1.0" min="-1.0" max="1.0" step="0.001" />
        <slider id="gravityZ" group="Gravity Vector" label="Gravity Z" default="0.0" min="-1.0" max="1.0" step="0.001" />

        <selector id="particleType" group="Particle" label="Particle Type" default="1"
            options="Line|Star|Shaded Sphere|Faded Sphere|Darken &amp; Faded Sphere|Bubble|Motion Polygon|Motion Square|TriPolygon|QuadPolygon|Textured TriPolygon|Textured QuadPolygon|Tetrahedron|Cube|Lens Convex|Lens Concave|Lens Fade|Lens Darken Fade|Lens Bubble|Textured Square|Textured Disc|Textured Faded Disc"
            values="1|2|4|5|6|7|9|10|11|12|13|14|15|16|18|19|20|21|22|24|25|26" />
        <texture id="textureLayer" src="layer" group="Texture" label="Texture Layer" empty="transparent" />
        <slider id="scatter" group="Texture" label="Scatter" default="0.0" min="0.0" max="100.0" step="0.1" />
        <selector id="textureTime" group="Texture" label="Texture Time" default="2"
            options="Birth|Current|From Start" values="1|2|3" />
        <switch id="alignToDirection" group="Texture" label="Align To Direction" default="false" />
        <slider id="rotationSpeed" group="Particle" label="Rotation Speed" default="180.0" min="0.0" max="18000.0" step="1.0" />
        <slider id="initialRotation" group="Particle" label="Initial Rotation" default="360.0" min="0.0" max="18000.0" step="1.0" />
        <selector id="rotationAxis" group="Particle" label="Rotation Axis" default="4"
            options="X Axis|Y Axis|Z Axis|Any Axis" values="1|2|3|4" />
        <slider id="birthSize" group="Particle" label="Birth Size" default="0.25" min="0.0" max="100.0" step="0.001" />
        <slider id="deathSize" group="Particle" label="Death Size" default="0.25" min="0.0" max="100.0" step="0.001" />
        <slider id="sizeVariation" group="Particle" label="Size Variation" default="50.0" min="0.0" max="100.0" step="0.1" />
        <slider id="maxOpacity" group="Particle" label="Max Opacity" default="75.0" min="0.0" max="100.0" step="0.1" />
        <selector id="colorMap" group="Particle" label="Color Map" default="2"
            options="Custom|Birth to Death|Origin to Death|Birth to Origin|Origin Constant" values="1|2|3|4|5" />
        <color id="birthColor" group="Particle" label="Birth Color" default="#FFFF50" />
        <color id="deathColor" group="Particle" label="Death Color" default="#C82828" />
        <color id="colorAtBirth" group="Custom Color Map" label="Color At Birth" default="#FFFFFF" />
        <color id="colorAt25" group="Custom Color Map" label="Color At 25%" default="#FFFF50" />
        <color id="colorAt50" group="Custom Color Map" label="Color At 50%" default="#FFA028" />
        <color id="colorAt75" group="Custom Color Map" label="Color At 75%" default="#C05C14" />
        <color id="colorAtDeath" group="Custom Color Map" label="Color At Death" default="#800000" />
        <slider id="volumeShade" group="Particle" label="Volume Shade (approx.)" default="0.0" min="0.0" max="100.0" step="0.1" />
        <selector id="transferMode" group="Particle" label="Transfer Mode" default="1"
            options="Composite|Screen|Add|Black Matte" values="1|2|3|4" />

        <slider id="camDistance" group="Effect Camera" label="Distance" default="1.0" min="-1000.0" max="1000.0" step="0.01" />
        <slider id="camRotX" group="Effect Camera" label="Rotation X" default="0.0" min="-36000.0" max="36000.0" step="1.0" type="angle" />
        <slider id="camRotY" group="Effect Camera" label="Rotation Y" default="0.0" min="-36000.0" max="36000.0" step="1.0" type="angle" />
        <slider id="camRotZ" group="Effect Camera" label="Rotation Z" default="0.0" min="-36000.0" max="36000.0" step="1.0" type="angle" />
        <slider id="fov" group="Effect Camera" label="FOV" default="45.0" min="0.0" max="160.0" step="0.1" />
        <selector id="depthCueType" group="Depth Cue" label="Type" default="1" options="None|Fade|Fog" values="1|2|3" />
        <slider id="depthCueDistance" group="Depth Cue" label="Distance" default="2.0" min="0.0" max="100.0" step="0.01" />
        <color id="fogColor" group="Depth Cue" label="Fog Color" default="#808080" />
        <slider id="lightX" group="Light Direction" label="Light X" default="-0.5773468017578125" min="-1.0" max="1.0" step="0.001" />
        <slider id="lightY" group="Light Direction" label="Light Y" default="0.5773468017578125" min="-1.0" max="1.0" step="0.001" />
        <slider id="lightZ" group="Light Direction" label="Light Z" default="0.5773468017578125" min="-1.0" max="1.0" step="0.001" />
        <slider id="holdParticleRelease" label="Hold Particle Release" default="0.0" min="0.0" max="100.0" step="0.1" />
        <switch id="compositeWithOriginal" label="Composite With Original" default="false" />
        <slider id="randomSeed" label="Random Seed" default="0" min="0" max="10000" step="1" type="integer" />
    </params>

    <!-- A cópia da entrada: quem desenha é o `PasseDoParticleWorld` (ver o comentário do topo). -->
    <shader><![CDATA[
void main() {
    fragColor = texture(inputImg, acScreenNorm);
}
    ]]></shader>
</effect>
