<?xml version="1.0" encoding="utf-8"?>
<!--
  NodeVideo/RenderCommand_roto_brush
  Gerado automaticamente do data.unity3d do NodeVideo (HLSLcc → GLSL ES 300).
  Entradas renomeadas: _SourceTex → inputImg, vs_TEXCOORD0 → acScreenNorm,
  SV_Target0 → fragColor. Faixas dos sliders são palpites por nome — ajuste conforme o visual.
-->
<effect
    id="nv.effect.nodevideo-rendercommand-roto-brush"
    name="Rendercommand Roto Brush (NV)"
    name-en="Rendercommand Roto Brush (NV)"
    desc="NodeVideo effect 'NodeVideo/RenderCommand_roto_brush', decompiled do bundle .unity3d."
    desc-en="NodeVideo effect 'NodeVideo/RenderCommand_roto_brush', decompiled do bundle .unity3d."
    category="nodevideo"
    tags="nodevideo,nv,unity,asset-store">

    <params>
        <texture id="inputImg" src="content" />
        <texture id="rotomask" src="content" empty="transparent" />
        <slider id="_has_mask" type="integer" label="Has Mask" default="0" min="0" max="10" step="1" />
    </params>

    <shader><![CDATA[
bool u_xlatb0;
vec4 u_xlat1;
vec4 u_xlat2;
void main()
{
    u_xlatb0 = int(_has_mask)==1;
    u_xlat1 = texture(rotomask, acScreenNorm.xy);
    u_xlat2 = texture(inputImg, acScreenNorm.xy);
    u_xlat1 = u_xlat1 + u_xlat2;
    fragColor = (bool(u_xlatb0)) ? u_xlat1 : u_xlat2;
    return;
}
    ]]></shader>
</effect>
