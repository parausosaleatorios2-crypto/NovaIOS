<?xml version="1.0" encoding="utf-8"?>
<effect
    id="nova.effect.ultramotion.ordereddither"
    name="Dither Ordenado (Ultra Motion)"
    name-en="Ordered Dither (Ultra Motion)"
    desc="Matriz Bayer 8×8 monocromática — 1-bit sobre preto e branco."
    desc-en="8×8 Bayer monochrome — 1-bit on black and white."
    category="stylize"
    tags="ultramotion,dither,ordered,1bit,bayer,mono">

    <params>
        <texture id="inputImg" src="content" />
        <slider id="scale"    label="Escala" default="2.0" min="1.0" max="12.0" step="0.5" />
        <slider id="brightness" label="Brilho" default="0.0" min="-0.4" max="0.4" step="0.01" />
        <color  id="darkColor" label="Cor baixa" default="#ff000000" />
        <color  id="lightColor" label="Cor alta" default="#ffffffff" />
    </params>

    <passes><pass /></passes>

    <shader><![CDATA[
const float BAYER8[64] = float[64](
     0.0, 32.0,  8.0, 40.0,  2.0, 34.0, 10.0, 42.0,
    48.0, 16.0, 56.0, 24.0, 50.0, 18.0, 58.0, 26.0,
    12.0, 44.0,  4.0, 36.0, 14.0, 46.0,  6.0, 38.0,
    60.0, 28.0, 52.0, 20.0, 62.0, 30.0, 54.0, 22.0,
     3.0, 35.0, 11.0, 43.0,  1.0, 33.0,  9.0, 41.0,
    51.0, 19.0, 59.0, 27.0, 49.0, 17.0, 57.0, 25.0,
    15.0, 47.0,  7.0, 39.0, 13.0, 45.0,  5.0, 37.0,
    63.0, 31.0, 55.0, 23.0, 61.0, 29.0, 53.0, 21.0
);
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

void main() {
    vec4 c = texture(inputImg, acScreenNorm);
    float l = clamp(dot(c.rgb, LUMA) + brightness, 0.0, 1.0);
    vec2 p = floor(acScreenNorm * acResolution / scale);
    int ix = int(mod(p.x, 8.0));
    int iy = int(mod(p.y, 8.0));
    float t = (BAYER8[iy * 8 + ix] + 0.5) / 64.0;
    float bit = step(t, l);
    vec3 cor = mix(darkColor.rgb, lightColor.rgb, bit);
    fragColor = vec4(cor, c.a);
}
    ]]></shader>
</effect>
