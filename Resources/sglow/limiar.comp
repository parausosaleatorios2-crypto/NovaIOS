// S_Glow — o limiar (o passe 0 do effects/sapphire-glow.xml e o `limiar` da 1ª caixa de lá) num alvo RGBA16F: a luz
// que entra nas caixas (`render/PasseDoSGlow`). As contas são as do XML, com os mesmos nomes. Compute (e não um passe
// de fragmento) para não depender de alvo float desenhável.
//
// Montagem (o Kotlin põe antes): `#version 310 es`.

precision highp float;
precision highp int;
precision mediump sampler2D;

layout(local_size_x = 16, local_size_y = 8) in;

uniform sampler2D inputImg;
uniform ivec2 uTam;
uniform float threshold;
uniform vec4 thresholdAddColor;
uniform float glowFromAlpha;
layout(rgba16f, binding = 0) writeonly uniform highp image2D uSaida;

vec3 corDoLimiar(ivec2 p) {
    vec4 t = texelFetch(inputImg, p, 0);
    vec3 c = max(t.rgb * t.a, vec3(0.0));
    return mix(c, vec3(t.a), clamp(glowFromAlpha, 0.0, 1.0));
}
float fatorDoLimiar(vec3 c) {
    float soma = c.r + c.g + c.b;
    if (soma < 1e-6) return 0.0;
    vec3 passa = max(c - (threshold + floor(thresholdAddColor.rgb * 255.0 + 0.5) / 255.0), vec3(0.0));
    return (passa.r + passa.g + passa.b) / soma / max(1.0 - threshold, 1e-6);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= uTam.x || p.y >= uTam.y) return;
    vec3 c = corDoLimiar(p);
    imageStore(uSaida, p, vec4(c * fatorDoLimiar(c), 0.0));
}
